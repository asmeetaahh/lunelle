# Copy to `.env` (git-ignored) and fill in.
#
# Base URL of the Lunelle V2 backend. A trailing slash is fine.
#
# EXPO_PUBLIC_* variables are inlined into the app bundle at build time and are
# visible to anyone who has the app. NEVER put secrets here.
#
# Reaching a backend running on your computer:
#   - iOS simulator:      http://localhost:<port>
#   - Android emulator:   http://10.0.2.2:<port>
#   - Physical device:    http://<your-computer-LAN-IP>:<port>
EXPO_PUBLIC_API_URL=

# Supabase project the Express API also uses (API_CONTRACT.md §9). Dashboard →
# Project Settings → API. The anon/publishable key is safe here — Row Level
# Security is what protects data, not secrecy of this key. NEVER put
# SUPABASE_SERVICE_ROLE_KEY or any other secret key in an EXPO_PUBLIC_* var.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
